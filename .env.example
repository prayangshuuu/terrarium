# ==============================================================================
# TERRARIUM — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env and configure your local settings.
# .env is gitignored and must NEVER be committed with real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: development | test | staging | production
TERRARIUM_ENV=development

# Application instance name
TERRARIUM_APP_NAME=TERRARIUM

# Enable debug logging and verbose terminal output (true | false)
TERRARIUM_DEBUG=false

# ------------------------------------------------------------------------------
# 2. LOCAL MACHINE PATHS
# Relative paths are automatically resolved against project root.
# ------------------------------------------------------------------------------
# Root directory for local persisted state and SQLite database
TERRARIUM_DATA_DIR=.terrarium/data

# Directory for execution logs and diagnostics
TERRARIUM_LOG_DIR=.terrarium/logs

# Directory where generated Markdown reports are saved
TERRARIUM_REPORTS_DIR=docs/reports

# SQLite database path (defaults to ${TERRARIUM_DATA_DIR}/terrarium.sqlite3)
# TERRARIUM_DB_PATH=.terrarium/data/terrarium.sqlite3

# ------------------------------------------------------------------------------
# 3. AI MODEL PROVIDER CREDENTIALS & ENDPOINTS
# Configure one or more providers. Ollama is enabled by default for zero-cost offline exploration.
# ------------------------------------------------------------------------------
# Anthropic (Claude 3.7 / 3.5 Sonnet & Haiku)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI (GPT-4o, o3-mini, Codex)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=your-optional-org-id

# Google Gemini (Gemini 2.5 Pro & Flash)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Ollama (Local open models: Llama 3, Qwen 2.5, DeepSeek)
# Install from: https://ollama.ai/
OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. ORCHESTRATION & PREFERENCES
# ------------------------------------------------------------------------------
# Default provider for task routing: anthropic | openai | gemini | ollama
TERRARIUM_DEFAULT_PROVIDER=anthropic

# Default model tier: fast | standard | advanced
TERRARIUM_DEFAULT_MODEL_TIER=standard

# Human approval gate mode for consequential actions:
#   always             — Require human approval for all tool actions
#   consequential_only — Require approval for file writes, git ops, paid calls, shell executions (default)
#   never              — Automated execution (use only in isolated sandboxes)
TERRARIUM_APPROVAL_MODE=consequential_only

# ------------------------------------------------------------------------------
# 5. EXECUTION & BUDGET LIMITS
# ------------------------------------------------------------------------------
# Maximum model tokens generated per agent turn
TERRARIUM_MAX_TOKENS_PER_TURN=8192

# Maximum recursive delegation depth (0-10)
TERRARIUM_MAX_DELEGATION_DEPTH=3

# Budget warning threshold percentage before triggering user alert (1-100)
TERRARIUM_WARNING_THRESHOLD_PERCENT=80

# Default dollar budget per individual orchestration task (USD)
TERRARIUM_DEFAULT_TASK_BUDGET_USD=0.50
